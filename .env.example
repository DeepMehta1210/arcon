# Database (PostgreSQL 16 + pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/growth_os?schema=public"

# Cache & Task Queue
REDIS_URL="redis://localhost:6379"

# WhatsApp Engine (WAHA Plus)
WAHA_BASE_URL="http://localhost:3000"
WAHA_API_KEY="secret-api-key"

# AI Inference (Antigravity Local / AWS Bedrock / Direct)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Security & Encryption
ENCRYPTION_SECRET="change-this-to-a-32-byte-hex-key"

# Outbound Defaults
DEFAULT_MAX_SENDS_PER_DAY=50
STE100_STRICT_MODE=true
